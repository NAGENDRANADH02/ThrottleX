# Copy this file to .env and adjust as needed.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Redis connection used by the rate limiter
REDIS_URL=redis://localhost:6379

# "open"   -> if Redis is down, allow all requests (availability first)
# "closed" -> if Redis is down, block all requests (enforcement first)
FAILOVER_MODE=open

LOG_LEVEL=INFO

# Origins allowed to call this API from the browser (comma-separated).
# The React dev server runs on 5173 by default - add your deployed
# frontend's URL here too once it's live.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
